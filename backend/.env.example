# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=

# JWT
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies
COOKIE_SECURE=false  # Set true in production (HTTPS)

# Rate limiting
RATE_LIMIT_ENABLED=true

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Price APIs
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Statement PDF preflight (10 MiB; files are not stored)
STATEMENT_PDF_MAX_BYTES=10485760

# Scheduled Daily Briefing Automation
BRIEFING_SCHEDULER_ENABLED=false
BRIEFING_SCHEDULE_HOUR=8
BRIEFING_SCHEDULE_MINUTE=0
BRIEFING_SCHEDULE_TIMEZONE=UTC

# Codex CLI Execution Timeouts (seconds)
CODEX_DEFAULT_TIMEOUT_SECONDS=180
CODEX_DEEP_RESEARCH_TIMEOUT_SECONDS=600


# Finance bridge: disabled when INTEGRATION_TOKEN is empty.
# Generate a separate random credential and bind it to an existing user UUID.
INTEGRATION_TOKEN=
INTEGRATION_USER_ID=

# Outbound Finance client only; never accepted as an inbound credential alias.
# In Compose, this is supplied from the root INTEGRATION_TOKEN.
PORTFOLIOMIND_API_TOKEN=
