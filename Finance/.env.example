# Copy to .env for Docker Compose. Python reads process environment only.
II_DB_HOST=127.0.0.1
II_DB_PORT=55432
II_DB_NAME=investment_intelligence
II_DB_USER=ii_local
# Set a local password before starting PostgreSQL; never commit .env.
II_DB_PASSWORD=

# Optional SEC disclosures: set a real application name + contact email in process environment.
# Example only: InvestmentIntelligence/0.1 contact@example.com
II_SEC_USER_AGENT=
PORTFOLIOMIND_SYNC_ENABLED=true
PORTFOLIOMIND_BASE_URL=http://localhost:8000
PORTFOLIOMIND_API_TOKEN=
CODEX_DEFAULT_TIMEOUT_SECONDS=180
CODEX_DEEP_RESEARCH_TIMEOUT_SECONDS=600
# Use the server's private, rotated INTEGRATION_TOKEN for API-token mode.
# Compose supplies it automatically; keep standalone client credentials private.
