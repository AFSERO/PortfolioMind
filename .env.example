# Backend
ENVIRONMENT=development
DATABASE_URL=
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
STATEMENT_PDF_MAX_BYTES=10485760

# Price APIs
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Frontend
VITE_API_URL=http://localhost:8000/api

# Gemini (Phase 3)
# GEMINI_API_KEY=your-gemini-api-key

# Finance bridge: disabled when INTEGRATION_TOKEN is empty.
# Generate a separate random credential and bind it to an existing user UUID.
INTEGRATION_TOKEN=
INTEGRATION_USER_ID=

# PostgreSQL password (no default; existing volumes require ALTER ROLE to rotate).
POSTGRES_PASSWORD=
